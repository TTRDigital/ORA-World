# ---- Site -------------------------------------------------------------------
# "staging" sends noindex headers and enables the direction switcher; "production" removes both.
NEXT_PUBLIC_SITE_ENV=staging
NEXT_PUBLIC_SITE_URL=https://ora-world-staging.vercel.app
# Header "Log In" link (future client portal)
NEXT_PUBLIC_PORTAL_URL=https://www.oraworld.com/login/

# ---- Sanity -----------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-01
# Server-only token with Editor rights: used to save leads and by the seed script
SANITY_API_WRITE_TOKEN=
# Random string shared with Sanity Presentation for draft-mode previews
SANITY_PREVIEW_SECRET=
# Sanity webhook secret for on-demand revalidation
SANITY_REVALIDATE_SECRET=

# ---- Maps -------------------------------------------------------------------
# Optional. When empty, the map uses OpenFreeMap tiles (no key). With a Mapbox token it uses Mapbox tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_SITE_LAT=18.4542
NEXT_PUBLIC_SITE_LNG=-66.3178

# ---- Contact -----------------------------------------------------------------
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=

# ---- Lead capture / CRM ------------------------------------------------------
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
# Cloudflare Turnstile (leave empty in local dev to bypass)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Confirmation email via Resend (set EMAIL_ENABLED=true to send)
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM="ORA World <hello@example.com>"
EMAIL_BCC=
# Optional Upstash Redis for distributed rate limiting (in-memory fallback otherwise)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Analytics ---------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
